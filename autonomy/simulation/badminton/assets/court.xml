          pos="-3.05 0 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="line_right" type="box" size="0.02 6.7 0.001"
          pos="3.05 0 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="line_far" type="box" size="3.05 0.02 0.001"
          pos="0 6.7 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="line_near" type="box" size="3.05 0.02 0.001"
          pos="0 -6.7 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <body name="net_body" pos="0 0 0">
      <geom name="net" type="box" size="3.05 0.01 0.38"
            pos="0 0 1.17" material="net_mat" solref="0.01 1.0"/>
      <geom name="net_post_l" type="cylinder" size="0.02 0.775"
            pos="-3.05 0 0.775" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>
      <geom name="net_post_r" type="cylinder" size="0.02 0.775"
