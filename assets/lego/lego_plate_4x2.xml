<mujoco model="lego_plate_4x2">
  <!--
    4x2 LEGO plate, built from MJCF primitives (no mesh files needed).
    Generated by assets/lego/generate.py -- edit that file, not this one.

    Include this file inside a <worldbody> to splice in one piece, e.g.:

      <mujoco>
        <include file="lego_plate_4x2.xml"/>
        <worldbody> ... </worldbody>
      </mujoco>

    Rename/duplicate the <body>/geom names if you spawn more than one piece
    in the same scene (MJCF requires unique names).
  -->
  <compiler angle="radian"/>

  <default>
    <default class="lego_plate_4x2">
      <!-- density is tuned down from ABS's real ~1050 kg/m3 so the solid
           primitive body (no hollow underside) lands near a real piece's mass -->
      <geom type="box" material="lego_yellow" density="500" friction="0.9 0.02 0.001"/>
      <default class="lego_plate_4x2/stud">
        <geom type="cylinder"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="lego_yellow" rgba="0.93 0.75 0.05 1"/>
  </asset>

  <worldbody>
    <body name="lego_plate_4x2" childclass="lego_plate_4x2">
      <freejoint name="lego_plate_4x2_freejoint"/>

      <!-- plate body: 4 studs long (x) x 2 studs wide (y) x 3.2mm tall (z) -->
      <!-- mass/inertia are left to MuJoCo, computed from geom volume x density above -->
      <geom name="lego_plate_4x2_body" size="0.0159 0.0079 0.0016" pos="0 0 0.0016"/>

      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_00" size="0.0024 0.00085" pos="-0.012 -0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_01" size="0.0024 0.00085" pos="-0.012 0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_10" size="0.0024 0.00085" pos="-0.004 -0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_11" size="0.0024 0.00085" pos="-0.004 0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_20" size="0.0024 0.00085" pos="0.004 -0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_21" size="0.0024 0.00085" pos="0.004 0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_30" size="0.0024 0.00085" pos="0.012 -0.004 0.00325"/>
      <geom class="lego_plate_4x2/stud" name="lego_plate_4x2_stud_31" size="0.0024 0.00085" pos="0.012 0.004 0.00325"/>
    </body>
  </worldbody>
</mujoco>
