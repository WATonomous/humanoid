<mujoco model="lego_brick_2x2">
  <!--
    2x2 LEGO brick, built from MJCF primitives (no mesh files needed).
    Generated by assets/lego/generate.py -- edit that file, not this one.

    Include this file inside a <worldbody> to splice in one piece, e.g.:

      <mujoco>
        <include file="lego_brick_2x2.xml"/>
        <worldbody> ... </worldbody>
      </mujoco>

    Rename/duplicate the <body>/geom names if you spawn more than one piece
    in the same scene (MJCF requires unique names).
  -->
  <compiler angle="radian"/>

  <default>
    <default class="lego_brick_2x2">
      <!-- density is tuned down from ABS's real ~1050 kg/m3 so the solid
           primitive body (no hollow underside) lands near a real piece's mass -->
      <geom type="box" material="lego_red" density="500" friction="0.9 0.02 0.001"/>
      <default class="lego_brick_2x2/stud">
        <geom type="cylinder"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="lego_red" rgba="0.77 0.06 0.05 1"/>
  </asset>

  <worldbody>
    <body name="lego_brick_2x2" childclass="lego_brick_2x2">
      <freejoint name="lego_brick_2x2_freejoint"/>

      <!-- brick body: 2 studs long (x) x 2 studs wide (y) x 9.6mm tall (z) -->
      <!-- mass/inertia are left to MuJoCo, computed from geom volume x density above -->
      <geom name="lego_brick_2x2_body" size="0.0079 0.0079 0.0048" pos="0 0 0.0048"/>

      <geom class="lego_brick_2x2/stud" name="lego_brick_2x2_stud_00" size="0.0024 0.00085" pos="-0.004 -0.004 0.00965"/>
      <geom class="lego_brick_2x2/stud" name="lego_brick_2x2_stud_01" size="0.0024 0.00085" pos="-0.004 0.004 0.00965"/>
      <geom class="lego_brick_2x2/stud" name="lego_brick_2x2_stud_10" size="0.0024 0.00085" pos="0.004 -0.004 0.00965"/>
      <geom class="lego_brick_2x2/stud" name="lego_brick_2x2_stud_11" size="0.0024 0.00085" pos="0.004 0.004 0.00965"/>
    </body>
  </worldbody>
</mujoco>
