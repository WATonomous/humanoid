<mujoco model="lego_tile_2x1">
  <!--
    2x1 LEGO tile, built from MJCF primitives (no mesh files needed).
    Generated by assets/lego/generate.py -- edit that file, not this one.

    Include this file inside a <worldbody> to splice in one piece, e.g.:

      <mujoco>
        <include file="lego_tile_2x1.xml"/>
        <worldbody> ... </worldbody>
      </mujoco>

    Rename/duplicate the <body>/geom names if you spawn more than one piece
    in the same scene (MJCF requires unique names).
  -->
  <compiler angle="radian"/>

  <default>
    <default class="lego_tile_2x1">
      <!-- density is tuned down from ABS's real ~1050 kg/m3 so the solid
           primitive body (no hollow underside) lands near a real piece's mass -->
      <geom type="box" material="lego_blue" density="500" friction="0.9 0.02 0.001"/>
    </default>
  </default>

  <asset>
    <material name="lego_blue" rgba="0.0 0.2 0.55 1"/>
  </asset>

  <worldbody>
    <body name="lego_tile_2x1" childclass="lego_tile_2x1">
      <freejoint name="lego_tile_2x1_freejoint"/>

      <!-- tile body: 2 studs long (x) x 1 studs wide (y) x 3.2mm tall (z) -->
      <!-- mass/inertia are left to MuJoCo, computed from geom volume x density above -->
      <geom name="lego_tile_2x1_body" size="0.0079 0.0039 0.0016" pos="0 0 0.0016"/>
    </body>
  </worldbody>
</mujoco>
